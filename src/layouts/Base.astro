---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import TopoFondo from '../components/TopoFondo.astro';
import { redesActivas, site, whatsappListo, correoListo } from '../lib/site';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo = site.seo.titulo, descripcion = site.seo.descripcion } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const imagenOg = new URL(site.seo.imagenOg, Astro.site ?? site.url).href;

const FUENTES =
  'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.nombre,
  url: site.url,
  logo: new URL('/icono.svg', site.url).href,
  description: site.seo.descripcion,
  address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressCountry: 'CO' },
  founder: { '@type': 'Person', name: site.autor, url: site.sitioPersonal },
  sameAs: redesActivas().map((r) => r.url),
};

// Aviso en el build si falta configuración clave (no rompe el build).
if (import.meta.env.PROD) {
  if (!whatsappListo()) console.warn('[SDL] Falta el número de WhatsApp en src/data/site.json');
  if (!correoListo()) console.warn('[SDL] Falta el correo en src/data/site.json');
}
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0B1F2A" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / redes -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.seo.imagenOgAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOg} />

    <!-- Fuentes: Space Grotesk (texto y títulos) + JetBrains Mono (etiquetas técnicas) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={FUENTES} />
    <link rel="stylesheet" href={FUENTES} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FUENTES} /></noscript>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      ANALÍTICA — activa UNA opción quitando los comentarios.
      Los eventos (whatsapp_click, formulario_enviado, suscripcion_curso, correo_click)
      ya se envían solos desde src/scripts/interacciones.ts: no hay que tocar nada más.

      Opción A · Plausible (ligera, sin cookies): ACTIVA, ver el script de abajo.
      Para cambiar a GA4, comenta el script de Plausible y descomenta la opción B.
    -->
    <script is:inline defer data-domain="sdl.danielflorez.dev" src="https://plausible.io/js/script.js"></script>
    <!--
      Opción B · Google Analytics 4 (cambia G-XXXXXXXXXX):
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-XXXXXXXXXX');
      </script>
    -->
  </head>
  <body class="relative min-h-screen bg-fondo text-texto antialiased overflow-x-hidden">
    <!-- Lienzo topográfico continuo e inmersivo en todo el sitio -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <TopoFondo semilla={3} class="absolute -top-32 left-1/2 -translate-x-1/2 h-[1400px] w-[1800px] text-turquesa opacity-[0.14]" />
      <TopoFondo semilla={7} class="absolute top-[35%] -left-64 h-[1200px] w-[1600px] text-verde opacity-[0.11]" />
      <TopoFondo semilla={11} class="absolute top-[65%] -right-64 h-[1400px] w-[1800px] text-turquesa opacity-[0.12]" />
      <!-- Luces ambientales de profundidad cinematográfica estilo Apple -->
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 h-[550px] w-[900px] rounded-full bg-verde/10 blur-[150px]"></div>
      <div class="absolute top-[38%] left-10 h-[500px] w-[500px] rounded-full bg-turquesa/[0.07] blur-[160px]"></div>
      <div class="absolute top-[68%] right-10 h-[600px] w-[600px] rounded-full bg-verde/[0.08] blur-[170px]"></div>
      <div class="absolute bottom-0 left-1/3 h-[500px] w-[700px] rounded-full bg-turquesa/[0.06] blur-[150px]"></div>
    </div>

    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-ambar focus:px-4 focus:py-3 focus:font-semibold focus:text-fondo"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFlotante />

    <script>
      import '../scripts/interacciones';
    </script>
  </body>
</html>
