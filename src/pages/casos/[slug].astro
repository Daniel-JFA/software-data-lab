---
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import { etiquetaEstado, publicas } from '../../lib/apps';
import { mostrarPendientes, vacio, whatsappUrl } from '../../lib/site';

export function getStaticPaths() {
  return publicas().map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;
const estado = etiquetaEstado(app);
const wa = whatsappUrl(
  `Hola Daniel, vi el caso ${app.nombre} en Software Data Lab y quiero hablar de algo parecido.`,
);
const waExterno = wa.startsWith('http');
---

<Base titulo={`${app.nombre} | Caso de Software Data Lab`} descripcion={app.resumen}>
  <article class="seccion" aria-labelledby="caso-titulo">
    <div class="contenedor">
      <div class="max-w-3xl">
        <nav aria-label="Ruta de navegación" class="text-sm text-suave">
          <a href="/" class="hover:text-turquesa-claro hover:underline transition-colors">Inicio</a>
          <span aria-hidden="true" class="mx-1.5 opacity-40"> / </span>
          <a href="/portafolio" class="hover:text-turquesa-claro hover:underline transition-colors">Portafolio</a>
          <span aria-hidden="true" class="mx-1.5 opacity-40"> / </span>
          <span aria-current="page" class="text-texto font-medium">{app.nombre}</span>
        </nav>

        <div class="badge-seccion mt-8">
          <span class="punto"></span>
          {app.categoria}
        </div>
        <h1 id="caso-titulo" class="titulo-seccion mt-4">{app.nombre}</h1>

        <div class="mt-4">
          {
            estado ? (
              <span class="inline-block rounded-full border border-white/[0.08] bg-white/[0.04] px-3.5 py-1 font-mono text-xs text-turquesa-claro">
                {estado}
              </span>
            ) : (
              mostrarPendientes && <span class="pendiente">[PENDIENTE] confirmar estado</span>
            )
          }
        </div>

        <p class="mt-6 text-xl leading-relaxed text-suave">{app.resumen}</p>

        <div class="mt-12 space-y-8 border-y border-white/[0.06] py-10">
          <section aria-labelledby="caso-problema">
            <h2 id="caso-problema" class="font-mono text-xs uppercase tracking-wider text-turquesa">El Problema</h2>
            <p class="mt-2 text-lg leading-relaxed text-texto/90">{app.problema}</p>
          </section>

          <section aria-labelledby="caso-solucion">
            <h2 id="caso-solucion" class="font-mono text-xs uppercase tracking-wider text-turquesa">La Solución</h2>
            <p class="mt-2 text-lg leading-relaxed text-texto/90">{app.solucion}</p>
          </section>

          <section aria-labelledby="caso-tecnologias">
            <h2 id="caso-tecnologias" class="font-mono text-xs uppercase tracking-wider text-turquesa mb-3">Stack Tecnológico</h2>
            {
              app.tecnologias.length > 0 ? (
                <ul class="flex flex-wrap gap-2">
                  {app.tecnologias.map((t) => (
                    <li class="rounded-lg border border-white/[0.08] bg-white/[0.04] px-3 py-1.5 font-mono text-xs text-turquesa-claro">
                      {t}
                    </li>
                  ))}
                </ul>
              ) : (
                mostrarPendientes && <span class="pendiente">[PENDIENTE] tecnologías</span>
              )
            }
          </section>
        </div>

        {
          !vacio(app.enlace) ? (
            <p class="mt-8">
              <a
                href={app.enlace}
                class="inline-flex items-center gap-2 font-semibold text-turquesa hover:text-turquesa-claro transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                Visitar {app.nombre}
                <span class="sr-only"> (se abre en otra pestaña)</span>
                <Icono nombre="externo" class="h-4 w-4" />
              </a>
            </p>
          ) : (
            mostrarPendientes && <span class="pendiente mt-8">[PENDIENTE] enlace del aplicativo</span>
          )
        }

        <div class="tarjeta mt-14 p-8">
          <h2 class="text-2xl font-bold tracking-tight text-texto">¿Necesitas algo parecido?</h2>
          <p class="mt-2 text-base text-suave">Cuéntanos tu caso en un diagnóstico gratis de 30 minutos sin costo.</p>
          <div class="mt-6 flex flex-col gap-3.5 sm:flex-row">
            <a
              href={wa}
              class="btn btn-primario"
              data-evento="whatsapp_click"
              data-ubicacion={`caso-${app.slug}`}
              target={waExterno ? '_blank' : undefined}
              rel={waExterno ? 'noopener noreferrer' : undefined}
            >
              <Icono nombre="whatsapp" class="h-5 w-5" />
              Agenda tu diagnóstico gratis
            </a>
            <a href="/portafolio" class="btn btn-secundario">Ver el portafolio</a>
          </div>
        </div>
      </div>
    </div>
  </article>
</Base>
