---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import datosLab from '../data/lab.json';
import datosCurso from '../data/curso.json';
import { redesActivas, site } from '../lib/site';

const redes = redesActivas();
const f = datosCurso.formulario;
---

<Base
  titulo="El Lab | Software Data Lab"
  descripcion="Laboratorio abierto de software, datos e IA en Medellín. Tutoriales, experimentos, noticias y análisis con datos reales."
>
  <section class="seccion" aria-labelledby="lab-landing-titulo">
    <div class="contenedor max-w-6xl">
      <!-- Navegación de migas -->
      <nav aria-label="Ruta de navegación" class="text-sm text-suave">
        <a href="/" class="hover:text-turquesa-claro hover:underline transition-colors">Inicio</a>
        <span aria-hidden="true" class="mx-1.5 opacity-40"> / </span>
        <span aria-current="page" class="text-texto font-medium">El Lab</span>
      </nav>

      <!-- Encabezado de la landing del Lab -->
      <div class="mt-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between border-b border-white/[0.08] pb-10">
        <div>
          <div class="badge-seccion">
            <span class="punto"></span>
            Laboratorio Abierto
          </div>
          <h1 id="lab-landing-titulo" class="titulo-seccion mt-4">{datosLab.titulo}</h1>
          <p class="mt-3 max-w-2xl text-lg text-suave">
            {datosLab.frase}
          </p>
        </div>
        <div class="font-mono text-xs text-turquesa-claro bg-turquesa/[0.06] border border-turquesa/20 px-3 py-2 rounded-lg w-fit">
          <span class="inline-block h-2 w-2 rounded-full bg-turquesa animate-pulse mr-2"></span>
          EN PRODUCCIÓN & EXPERIMENTOS
        </div>
      </div>

      <!-- Grid estilo panel de laboratorio (inspirado en propuesta C) -->
      <div class="mt-12 grid gap-8 lg:grid-cols-12">
        
        <!-- Panel 1: Series técnicas del Lab (8 col) -->
        <div class="lg:col-span-8 tarjeta !p-0 overflow-hidden">
          <div class="flex items-center justify-between border-b border-white/[0.08] bg-superficie/80 px-5 py-3 font-mono text-xs uppercase tracking-wider text-suave">
            <span>{datosLab.seriesTitulo}</span>
            <span class="text-turquesa">{datosLab.series.length} series activas</span>
          </div>
          <ul class="divide-y divide-white/[0.06] p-4 sm:p-6 space-y-2">
            {
              datosLab.series.map((s) => (
                <li class="group flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 rounded-lg transition-colors hover:bg-white/[0.03]">
                  <div class="flex items-start gap-3.5">
                    <span class="rounded border border-turquesa/30 bg-turquesa/[0.08] px-2 py-0.5 font-mono text-[0.6875rem] font-semibold text-turquesa-claro shrink-0 mt-0.5">
                      {s.formato}
                    </span>
                    <div>
                      <h3 class="font-bold text-texto text-base tracking-tight">{s.nombre}</h3>
                      <p class="mt-0.5 text-xs text-suave leading-relaxed">{s.descripcion}</p>
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Panel 2: Canales y plataformas (4 col) -->
        <div class="lg:col-span-4 tarjeta flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-white/[0.08] pb-3 font-mono text-xs uppercase tracking-wider text-suave">
              <span>Canales</span>
              <span class="text-turquesa">{redes.length} plataformas</span>
            </div>
            <p class="mt-4 text-sm text-suave">
              {datosLab.redesTitulo || 'Síguenos en nuestras plataformas'}. Publicamos avances, tutoriales y análisis de datos sin humo.
            </p>
            <div class="mt-6 flex flex-col gap-3">
              {
                redes.map((r) => (
                  <a
                    href={r.url}
                    class="btn btn-secundario !justify-between !px-4"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="flex items-center gap-2.5 font-mono text-xs">
                      <Icono nombre={r.id} class="h-4 w-4 text-turquesa" />
                      {r.nombre}
                    </span>
                    <Icono nombre="externo" class="h-3.5 w-3.5 opacity-60" />
                  </a>
                ))
              }
            </div>
          </div>

          <div class="mt-8 border-t border-white/[0.06] pt-4">
            <p class="font-mono text-xs text-suave/80">
              ¿Tienes una idea para probar en el Lab?
            </p>
            <a href="/#contacto" class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-turquesa hover:text-turquesa-claro transition-colors">
              Escríbenos una propuesta
              <Icono nombre="flecha" class="h-3.5 w-3.5" />
            </a>
          </div>
        </div>

      </div>

      <!-- Sección del Curso dentro de la landing del Lab -->
      <div class="mt-16 border-t border-white/[0.08] pt-16">
        <div class="badge-seccion">
          <span class="punto"></span>
          Formación Abierta
        </div>
        <h2 class="titulo-seccion mt-4">
          {datosCurso.titulo} — <span class="text-turquesa-claro">{datosCurso.subtitulo}</span>
        </h2>
        <p class="mt-4 max-w-2xl text-lg text-suave">
          {datosCurso.descripcion}
        </p>

        <div class="mt-10 grid gap-10 lg:grid-cols-12">
          <!-- Temario -->
          <div class="lg:col-span-7 tarjeta !p-0 overflow-hidden">
            <div class="flex items-center justify-between border-b border-white/[0.08] bg-superficie/80 px-5 py-3 font-mono text-xs uppercase tracking-wider text-suave">
              <span>Temario de lecciones</span>
              <span class="text-turquesa">6 lecciones prácticas</span>
            </div>
            <ol class="divide-y divide-white/[0.06] p-4 sm:p-6">
              {
                datosCurso.lecciones.map((l, i) => (
                  <li class="flex gap-4 py-3.5 first:pt-1 last:pb-1">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded border border-turquesa/30 bg-turquesa/[0.08] font-mono text-xs font-semibold text-turquesa-claro">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <div>
                      <h3 class="font-bold text-texto text-base tracking-tight">{l.titulo}</h3>
                      <p class="mt-0.5 text-xs text-suave leading-relaxed">{l.resumen}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>

          <!-- Formulario de lista de espera -->
          <div class="lg:col-span-5 tarjeta h-fit">
            <h3 class="text-xl font-bold tracking-tight text-texto">{f.titulo}</h3>
            <p class="mt-1.5 text-sm text-suave">{f.descripcion}</p>

            <form
              class="mt-6 space-y-4"
              data-endpoint={site.formularios.cursoEndpoint}
              data-nombre="curso-futbol"
              data-evento-exito="suscripcion_curso"
              data-exito={f.exito}
            >
              <div>
                <label for="lab-curso-nombre" class="mb-1.5 block text-xs font-mono uppercase tracking-wider text-turquesa">{f.campoNombre || 'Nombre'}</label>
                <input
                  id="lab-curso-nombre"
                  name="nombre"
                  type="text"
                  class="campo"
                  autocomplete="name"
                  required
                  maxlength="120"
                />
              </div>
              <div>
                <label for="lab-curso-correo" class="mb-1.5 block text-xs font-mono uppercase tracking-wider text-turquesa">{f.campoCorreo || 'Correo'}</label>
                <input
                  id="lab-curso-correo"
                  name="email"
                  type="email"
                  class="campo"
                  autocomplete="email"
                  required
                  maxlength="120"
                />
              </div>

              <div style="position: absolute; left: -9999px;" aria-hidden="true">
                <input name="_gotcha" tabindex="-1" autocomplete="off" />
              </div>

              <button type="submit" class="btn btn-primario w-full">
                {f.boton}
              </button>

              <p class="text-xs leading-relaxed text-suave/80">{f.consentimiento}</p>
              <p data-estado class="min-h-6 text-sm" role="status" aria-live="polite"></p>
            </form>
          </div>
        </div>
      </div>

    </div>
  </section>
</Base>
