---
// Landing del Lab: documento propio con la vista de la propuesta C (panel de control de laboratorio).
// El contenido sale de src/data/lab.json y src/data/curso.json; el estilo, de src/styles/lab.css.
import '../styles/lab.css';
import datosLab from '../data/lab.json';
import datosCurso from '../data/curso.json';
import { redesActivas, site, whatsappListo, whatsappUrl } from '../lib/site';

const redes = redesActivas();
const f = datosCurso.formulario;
const titulo = 'El Lab | Software Data Lab';
const descripcion =
  'Laboratorio abierto de software, datos e IA en Medellín. Tutoriales, experimentos, noticias y análisis con datos reales.';
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const imagenOg = new URL(site.seo.imagenOg, Astro.site ?? site.url).href;
const secciones = [
  ['inicio', 'Inicio del Lab'],
  ['series', 'Series'],
  ['curso', 'Curso'],
  ['canales', 'Canales'],
] as const;
const FUENTES = 'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap';
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0B1F2A" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenOg} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href={FUENTES} media="print" onload="this.media='all'" />
    <script is:inline defer data-domain="sdl.danielflorez.dev" src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <div class="top">
      <a class="brand" href="#inicio"><img src="/simbolo.svg" alt="" width="30" height="30" /><b>SDL</b></a>
      <button type="button" id="menuBtn" aria-expanded="false" aria-controls="side">Menú</button>
    </div>

    <aside class="side" id="side" aria-label="Navegación del Lab">
      <a class="brand" href="/">
        <img src="/simbolo.svg" alt="" width="40" height="40" />
        <div><b>{site.nombre}</b><span>lab / medellin</span></div>
      </a>
      <nav aria-label="Secciones del Lab">
        {secciones.map(([id, nombre], i) => (
          <a href={`#${id}`} data-s={id}><i>{String(i).padStart(2, '0')}</i>{nombre}</a>
        ))}
      </nav>
      <a class="cmdbtn" href="/"><span>← Volver al sitio</span></a>
    </aside>

    <main id="contenido">
      <div class="wrap">
        <!-- INICIO -->
        <section id="inicio" class="hero lab-hero" aria-labelledby="h-inicio">
          <div class="grid">
            <div class="p s8 hero-main">
              <header><span>sdl / lab</span><span class="st produccion live">laboratorio abierto</span></header>
              <div class="b">
                <h1 id="h-inicio">{datosLab.titulo}</h1>
                <p class="lead">{datosLab.frase}</p>
                <div class="cta">
                  <a class="btn pri" href="#curso">Entrar a la lista de espera</a>
                  <a class="btn" href="#series">Ver las series</a>
                </div>
              </div>
            </div>
            <div class="p s4">
              <header><span>estado</span><span>en vivo</span></header>
              <div class="b">
                <dl class="kv">
                  <dt>series</dt><dd>{datosLab.series.length}</dd>
                  <dt>lecciones</dt><dd>{datosCurso.lecciones.length}</dd>
                  <dt>canales</dt><dd>{redes.length}</dd>
                  <dt>sede</dt><dd>Medellín, CO</dd>
                </dl>
                <p class="term" style="margin-top:14px"><b>$</b> lab --abierto<br />tutoriales · noticias · experimentos<br /><b>$</b> <span class="cur" aria-hidden="true"></span></p>
              </div>
            </div>
          </div>
        </section>

        <!-- SERIES -->
        <section id="series" aria-labelledby="h-series">
          <div class="sh"><span class="id">01</span><h2 id="h-series">{datosLab.seriesTitulo}</h2><p>Un laboratorio abierto: tutoriales, noticias y experimentos de datos e IA.</p></div>
          <div class="p">
            <header><span>series del lab</span><span>{datosLab.series.length}</span></header>
            <ul class="series">
              {datosLab.series.map((s) => (
                <li><span class="f">{s.formato}</span><div><b>{s.nombre}</b><span>{s.descripcion}</span></div></li>
              ))}
            </ul>
          </div>
        </section>

        <!-- CURSO -->
        <section id="curso" aria-labelledby="h-curso">
          <div class="sh"><span class="id">02</span><h2 id="h-curso">{datosCurso.titulo}</h2><p>{datosCurso.descripcion}</p></div>
          <div class="grid">
            <div class="p s7">
              <header><span>temario</span><span>{datosCurso.subtitulo}</span></header>
              <ol class="les">
                {datosCurso.lecciones.map((l, i) => (
                  <li><i>{datosCurso.prefijoLeccion}{String(i + 1).padStart(2, '0')}</i><div><b>{l.titulo}</b><span>{l.resumen}</span></div></li>
                ))}
              </ol>
            </div>
            <div class="p s5">
              <header><span>lista de espera</span><span class="st por-confirmar">abierta</span></header>
              <div class="b form">
                <h3>{f.titulo}</h3>
                <p>{f.descripcion}</p>
                <form
                  data-endpoint={site.formularios.cursoEndpoint}
                  data-nombre="curso-futbol"
                  data-evento-exito="suscripcion_curso"
                  data-exito={f.exito}
                >
                  <label for="lab-nombre">{f.campoNombre || 'Nombre'}</label>
                  <input id="lab-nombre" name="nombre" type="text" autocomplete="name" required maxlength="120" />
                  <label for="lab-correo">{f.campoCorreo || 'Correo'}</label>
                  <input id="lab-correo" name="email" type="email" autocomplete="email" required maxlength="120" placeholder="tu@correo.com" />
                  <div style="position:absolute;left:-9999px" aria-hidden="true"><input name="_gotcha" tabindex="-1" autocomplete="off" /></div>
                  <button class="btn pri" type="submit">{f.boton}</button>
                  <p class="fine">{f.consentimiento}</p>
                  <p data-estado role="status" aria-live="polite"></p>
                </form>
              </div>
            </div>
          </div>
        </section>

        <!-- CANALES -->
        <section id="canales" aria-labelledby="h-canales">
          <div class="sh"><span class="id">03</span><h2 id="h-canales">Canales</h2><p>{datosLab.redesTitulo}. Publicamos avances, tutoriales y análisis sin humo.</p></div>
          <div class="grid">
            <div class="p s6">
              <header><span>plataformas</span><span>{redes.length}</span></header>
              <div class="b">
                <div class="chan">
                  {redes.map((r) => (
                    <a class="btn" href={r.url} target="_blank" rel="noopener noreferrer"><span>{r.nombre}</span><span aria-hidden="true">↗</span></a>
                  ))}
                </div>
              </div>
            </div>
            <div class="p s6">
              <header><span>propón un experimento</span><span>abierto</span></header>
              <div class="b">
                <h3>¿Tienes una idea para probar en el Lab?</h3>
                <p>Cuéntanosla y vemos si la convertimos en una serie, un tutorial o un experimento.</p>
                <p style="margin:0"><a class="btn" href={whatsappListo() ? whatsappUrl('Hola, tengo una idea para el Lab de SDL.') : '/#contacto'}>Escríbenos una propuesta</a></p>
              </div>
            </div>
          </div>
        </section>

        <footer>
          <span>© {site.nombre} · Medellín, Colombia</span>
          <ul>
            <li><a href="/">Inicio</a></li>
            <li><a href="/politica-datos">Política de datos</a></li>
          </ul>
        </footer>
      </div>
    </main>

    <script>
      import '../scripts/interacciones';

      const side = document.getElementById('side');
      const boton = document.getElementById('menuBtn');
      const menu = (abrir: boolean): void => {
        side?.classList.toggle('open', abrir);
        boton?.setAttribute('aria-expanded', String(abrir));
      };
      boton?.addEventListener('click', () => menu(!side?.classList.contains('open')));
      side?.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) menu(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && side?.classList.contains('open')) {
          menu(false);
          boton?.focus();
        }
      });

      // Sección activa en la barra lateral.
      const enlaces = document.querySelectorAll<HTMLAnchorElement>('.side nav a');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entradas) =>
            entradas.forEach((en) => {
              if (!en.isIntersecting) return;
              enlaces.forEach((l) => {
                l.removeAttribute('aria-current');
                if (l.dataset.s === en.target.id) l.setAttribute('aria-current', 'true');
              });
            }),
          { rootMargin: '-30% 0px -60% 0px' },
        );
        document.querySelectorAll('main section').forEach((s) => io.observe(s));
      }
    </script>
  </body>
</html>
