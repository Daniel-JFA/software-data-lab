---
import Icono from './Icono.astro';
import datos from '../data/servicios.json';
---

<section id="servicios" class="seccion" aria-labelledby="servicios-titulo">
  <div class="contenedor">
    <div class="badge-seccion">
      <span class="punto"></span>
      Servicios
    </div>
    <h2 id="servicios-titulo" class="titulo-seccion mt-4">{datos.titulo}</h2>
    <p class="mt-4 max-w-2xl text-lg text-suave">{datos.intro}</p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      
      <!-- Card 1: Software a la medida (Bento Wide 2 col) -->
      <div class="tarjeta group sm:col-span-2 flex flex-col justify-between overflow-hidden">
        <div>
          <div class="flex items-center justify-between">
            <span class="grid h-11 w-11 place-items-center rounded-lg border border-borde bg-superficie text-turquesa-claro">
              <Icono nombre="codigo" class="h-5 w-5" />
            </span>
            <span class="rounded-md border border-turquesa/20 bg-turquesa/[0.06] px-2.5 py-1 font-mono text-[0.7rem] uppercase tracking-wider text-turquesa-claro">
              Full Stack & APIs
            </span>
          </div>
          <h3 class="mt-6 text-2xl font-bold tracking-tight text-texto">{datos.items[0].titulo}</h3>
          <p class="mt-2.5 max-w-xl text-base leading-relaxed text-suave">{datos.items[0].descripcion}</p>
        </div>

        <div class="mt-8 rounded-lg border border-white/[0.06] bg-fondo/80 p-4 font-mono text-xs text-suave/90">
          <div class="flex items-center gap-2 border-b border-white/[0.06] pb-2 text-[0.7rem] text-turquesa">
            <span class="h-1.5 w-1.5 rounded-full bg-turquesa"></span>
            <span>CASO REAL · ARQUITECTURA</span>
          </div>
          <p class="mt-2.5 text-sm font-sans text-texto/90">{datos.items[0].ejemplo}</p>
        </div>
      </div>

      <!-- Card 2: Analítica y tableros (Bento 1 col) -->
      <div class="tarjeta group flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="grid h-11 w-11 place-items-center rounded-lg border border-borde bg-superficie text-turquesa-claro">
              <Icono nombre="grafico" class="h-5 w-5" />
            </span>
            <span class="rounded-md border border-verde/30 bg-verde/[0.1] px-2.5 py-1 font-mono text-[0.7rem] uppercase tracking-wider text-turquesa-claro">
              BI & SQL
            </span>
          </div>
          <h3 class="mt-6 text-xl font-bold tracking-tight text-texto">{datos.items[1].titulo}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-suave">{datos.items[1].descripcion}</p>
        </div>

        <div class="mt-6 border-t border-white/[0.06] pt-4">
          <span class="font-mono text-[0.7rem] uppercase tracking-wider text-turquesa">Ejemplo real</span>
          <p class="mt-1 text-xs leading-relaxed text-suave">{datos.items[1].ejemplo}</p>
        </div>
      </div>

      <!-- Card 3: IA aplicada y agentes (Bento 1 col) -->
      <div class="tarjeta group flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="grid h-11 w-11 place-items-center rounded-lg border border-borde bg-superficie text-turquesa-claro">
              <Icono nombre="cerebro" class="h-5 w-5" />
            </span>
            <span class="rounded-md border border-turquesa/20 bg-turquesa/[0.06] px-2.5 py-1 font-mono text-[0.7rem] uppercase tracking-wider text-turquesa-claro">
              Whisper · LLMs
            </span>
          </div>
          <h3 class="mt-6 text-xl font-bold tracking-tight text-texto">{datos.items[2].titulo}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-suave">{datos.items[2].descripcion}</p>
        </div>

        <div class="mt-6 border-t border-white/[0.06] pt-4">
          <span class="font-mono text-[0.7rem] uppercase tracking-wider text-turquesa">Ejemplo real</span>
          <p class="mt-1 text-xs leading-relaxed text-suave">{datos.items[2].ejemplo}</p>
        </div>
      </div>

      <!-- Card 4: IoT y sensores (Bento Wide 2 col) -->
      <div class="tarjeta group sm:col-span-2 flex flex-col justify-between overflow-hidden">
        <div>
          <div class="flex items-center justify-between">
            <span class="grid h-11 w-11 place-items-center rounded-lg border border-borde bg-superficie text-turquesa-claro">
              <Icono nombre="sensor" class="h-5 w-5" />
            </span>
            <span class="rounded-md border border-turquesa/20 bg-turquesa/[0.06] px-2.5 py-1 font-mono text-[0.7rem] uppercase tracking-wider text-turquesa-claro">
              Telemetría · Tiempo Real
            </span>
          </div>
          <h3 class="mt-6 text-2xl font-bold tracking-tight text-texto">{datos.items[3].titulo}</h3>
          <p class="mt-2.5 max-w-xl text-base leading-relaxed text-suave">{datos.items[3].descripcion}</p>
        </div>

        <div class="mt-8 rounded-lg border border-white/[0.06] bg-fondo/80 p-4 font-mono text-xs text-suave/90">
          <div class="flex items-center gap-2 border-b border-white/[0.06] pb-2 text-[0.7rem] text-turquesa">
            <span class="h-1.5 w-1.5 rounded-full bg-verde"></span>
            <span>DISPOSITIVOS & ALERTAS</span>
          </div>
          <p class="mt-2.5 text-sm font-sans text-texto/90">{datos.items[3].ejemplo}</p>
        </div>
      </div>

    </div>
  </div>
</section>
