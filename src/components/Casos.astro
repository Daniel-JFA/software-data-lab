---
import Icono from './Icono.astro';
import datos from '../data/casos.json';
import { destacadas } from '../lib/apps';
import { mostrarPendientes } from '../lib/site';

// Solo destacados, públicos y con autorización (la regla vive en lib/apps.ts).
const destacados = destacadas();
---

<section id="casos" class="seccion" aria-labelledby="casos-titulo">
  <div class="contenedor">
    <div class="badge-seccion">
      <span class="punto"></span>
      {datos.etiqueta || 'Casos de estudio'}
    </div>
    <h2 id="casos-titulo" class="titulo-seccion mt-4">{datos.titulo}</h2>
    <p class="mt-4 max-w-2xl text-lg text-suave">{datos.intro}</p>

    <ul class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        destacados.map((c) => (
          <li class="tarjeta group flex flex-col justify-between">
            <div>
              <span class="inline-block rounded-md border border-turquesa/20 bg-turquesa/[0.06] px-2.5 py-0.5 font-mono text-[0.7rem] uppercase tracking-wider text-turquesa-claro">
                {c.categoria}
              </span>
              <h3 class="mt-3 text-2xl font-bold tracking-tight text-texto">{c.nombre}</h3>

              <div class="mt-6 space-y-4 text-sm leading-relaxed text-suave">
                <div>
                  <p class="font-mono text-xs uppercase tracking-wider text-turquesa">{datos.problema || 'Problema'}</p>
                  <p class="mt-1">{c.problema}</p>
                </div>
                <div>
                  <p class="font-mono text-xs uppercase tracking-wider text-turquesa">{datos.solucion || 'Solución'}</p>
                  <p class="mt-1">{c.solucion}</p>
                </div>
                <div>
                  <p class="font-mono text-xs uppercase tracking-wider text-turquesa mb-2">{datos.tecnologias || 'Tecnologías'}</p>
                  {c.tecnologias.length > 0 ? (
                    <ul class="flex flex-wrap gap-1.5">
                      {c.tecnologias.map((t) => (
                        <li class="rounded-md border border-white/[0.08] bg-white/[0.04] px-2.5 py-1 font-mono text-xs text-turquesa-claro">
                          {t}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    mostrarPendientes && <span class="pendiente">[PENDIENTE] tecnologías</span>
                  )}
                </div>
              </div>
            </div>

            <div class="mt-8 border-t border-white/[0.06] pt-4">
              <a
                href={`/casos/${c.slug}`}
                class="inline-flex items-center gap-2 font-semibold text-turquesa hover:text-turquesa-claro transition-colors"
              >
                {datos.enlaceTexto}
                <span class="sr-only"> de {c.nombre}</span>
                <span class="transition-transform duration-200 group-hover:translate-x-1">
                  <Icono nombre="flecha" class="h-4 w-4" />
                </span>
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex justify-center sm:justify-start">
      <a href="/portafolio" class="btn btn-secundario">
        {datos.portafolio || 'Ver todo el portafolio'}
        <Icono nombre="flecha" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
