---
// Fondo topográfico cartográfico real de Medellín y el Valle de Aburrá.
// Curvas de nivel extraídas de datos de elevación reales (DEM SRTM) y perímetro oficial de la ciudad.
// 100% SVG vectorial estático, cero JavaScript en cliente, optimizado para alto rendimiento.
import datos from '../data/medellin-topo.json';

interface Props {
  class?: string;
  mostrarEtiquetas?: boolean;
}

const { class: clase = '', mostrarEtiquetas = true } = Astro.props;
---

<svg
  class={clase}
  viewBox="0 0 1000 1125"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <!-- Curvas de nivel topográficas del Valle de Aburrá -->
  <g class="curvas" stroke="currentColor" vector-effect="non-scaling-stroke">
    {
      datos.paths.map((p) => (
        <path
          d={p.d}
          stroke-width={p.is_major ? '1.2' : '0.75'}
          opacity={p.is_major ? '0.75' : '0.42'}
        />
      ))
    }
  </g>

  <!-- Perímetro urbano oficial de Medellín -->
  <path
    d={datos.urb_d}
    stroke="#2A9D8F"
    stroke-width="1.35"
    stroke-dasharray="4 3"
    opacity="0.8"
    vector-effect="non-scaling-stroke"
  />

  <!-- Eje hidrográfico del Río Medellín -->
  <path
    d={datos.rio_d}
    stroke="#7FD6CB"
    stroke-width="1.8"
    opacity="0.85"
    vector-effect="non-scaling-stroke"
  />

  <!-- Hitos geográficos, cerros tutelares y coordenadas cartográficas -->
  {
    mostrarEtiquetas && (
      <g class="hitos font-mono select-none pointer-events-none">
        {datos.landmarks.map((l) => (
          <g transform={`translate(${l.x}, ${l.y})`}>
            <circle r="2.5" fill="#7FD6CB" opacity="0.9" />
            <circle r="5.5" stroke="#7FD6CB" stroke-width="0.75" opacity="0.4" />
            <text
              x="9"
              y="3"
              fill="#9BE5DA"
              opacity="0.8"
              font-size="8.5"
              font-family="'JetBrains Mono', monospace"
              letter-spacing="0.06em"
            >
              {l.name} · {l.elev}
            </text>
          </g>
        ))}

        <!-- Coordenadas cartográficas de referencia -->
        <text
          x="32"
          y="42"
          fill="#7FD6CB"
          opacity="0.8"
          font-size="10"
          font-family="'JetBrains Mono', monospace"
          letter-spacing="0.08em"
        >
          6° 14' 58" N · 75° 34' 05" W
        </text>
        <text
          x="32"
          y="58"
          fill="#B4C4C7"
          opacity="0.55"
          font-size="8"
          font-family="'JetBrains Mono', monospace"
          letter-spacing="0.05em"
        >
          VALLE DE ABURRÁ // RELIEVE TOPOGRÁFICO MEDELLÍN
        </text>
      </g>
    )
  }
</svg>
