---
import Icono from './Icono.astro';
import { site, whatsappUrl } from '../lib/site';

const wa = whatsappUrl();
const enlaceExterno = wa.startsWith('http');
---

<header class="fixed top-3 sm:top-5 inset-x-0 z-50 flex justify-center px-3 sm:px-6">
  <div class="w-full max-w-5xl rounded-full border border-white/[0.12] bg-[#0b1f2a]/70 px-4 sm:px-6 py-2.5 backdrop-blur-2xl shadow-[0_12px_40px_rgba(0,0,0,0.55),inset_0_1px_0_0_rgba(255,255,255,0.15)] flex items-center justify-between gap-4">
    <a
      href="/#inicio"
      class="flex shrink-0 items-center transition-opacity hover:opacity-85 pl-1"
      aria-label={`${site.nombre}, ir al inicio`}
    >
      <img src="/logo.svg" alt={site.nombre} width="737" height="274" class="h-8 w-auto" />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1 lg:flex">
      {
        site.navegacion.map((n) => (
          <a
            href={`/${n.href}`}
            class="rounded-full px-3.5 py-1.5 text-xs font-medium tracking-wide text-suave/90 transition-all hover:bg-white/[0.08] hover:text-white"
          >
            {n.etiqueta}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={wa}
        class="btn btn-primario !min-h-9 !px-4 !py-1.5 text-xs font-semibold !rounded-full hidden sm:inline-flex"
        data-evento="whatsapp_click"
        data-ubicacion="header"
        target={enlaceExterno ? '_blank' : undefined}
        rel={enlaceExterno ? 'noopener noreferrer' : undefined}
      >
        Diagnóstico gratis
      </a>

      <button
        type="button"
        id="menu-boton"
        class="grid h-9 w-9 place-items-center rounded-full border border-white/10 bg-white/[0.04] text-texto backdrop-blur transition-all hover:border-turquesa/30 hover:bg-white/[0.08] lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
      >
        <span data-icono-abrir><Icono nombre="menu" class="h-5 w-5" /></span>
        <span data-icono-cerrar hidden><Icono nombre="cerrar" class="h-5 w-5" /></span>
      </button>
    </div>
  </div>

  <!-- Menú móvil flotante estilo tarjeta Apple -->
  <div id="menu-movil" hidden class="absolute top-16 inset-x-4 max-w-md mx-auto rounded-3xl border border-white/[0.12] bg-[#0b1f2a]/95 p-5 shadow-2xl backdrop-blur-2xl lg:hidden">
    <nav aria-label="Principal (móvil)" class="flex flex-col gap-1">
      {
        site.navegacion.map((n) => (
          <a
            href={`/${n.href}`}
            class="rounded-xl px-4 py-2.5 text-sm font-medium text-texto/90 transition-colors hover:bg-white/[0.06] hover:text-turquesa-claro"
            data-cerrar-menu
          >
            {n.etiqueta}
          </a>
        ))
      }
      <a
        href={wa}
        class="btn btn-primario mt-3 !rounded-xl"
        data-evento="whatsapp_click"
        data-ubicacion="menu-movil"
        data-cerrar-menu
        target={enlaceExterno ? '_blank' : undefined}
        rel={enlaceExterno ? 'noopener noreferrer' : undefined}
      >
        Agenda tu diagnóstico gratis
      </a>
    </nav>
  </div>
</header>
