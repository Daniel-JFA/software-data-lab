---
import Icono from './Icono.astro';
import { site } from '../lib/site';
---

<header class="sticky top-0 z-50 w-full border-b border-borde/70 bg-[#0b1f2a]/90 backdrop-blur-md">
  <div class="contenedor flex h-16 items-center justify-between gap-4">
    <a
      href="/#inicio"
      class="flex shrink-0 items-center transition-opacity hover:opacity-85"
      aria-label={`${site.nombre}, ir al inicio`}
    >
      <img src="/logo.svg" alt={site.nombre} width="737" height="274" class="h-8 w-auto" />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1 lg:flex">
      {
        site.navegacion.map((n) => (
          <a
            href={`/${n.href}`}
            class="rounded-lg px-3 py-1.5 text-xs font-medium tracking-wide text-suave transition-colors hover:bg-white/[0.06] hover:text-white"
          >
            {n.etiqueta}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/diagnostico"
        class="btn btn-primario !min-h-9 !px-4 !py-1.5 text-xs font-semibold hidden sm:inline-flex"
        data-evento="diagnostico_click"
        data-ubicacion="header"
      >
        Diagnóstico gratis
      </a>

      <button
        type="button"
        id="menu-boton"
        class="grid h-9 w-9 place-items-center rounded-lg border border-borde bg-superficie text-texto transition-colors hover:border-turquesa/50 lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
      >
        <span data-icono-abrir><Icono nombre="menu" class="h-5 w-5" /></span>
        <span data-icono-cerrar hidden><Icono nombre="cerrar" class="h-5 w-5" /></span>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="menu-movil" hidden class="border-b border-borde bg-[#0b1f2a] px-4 py-4 lg:hidden">
    <nav aria-label="Principal (móvil)" class="flex flex-col gap-1">
      {
        site.navegacion.map((n) => (
          <a
            href={`/${n.href}`}
            class="rounded-lg px-3 py-2 text-sm font-medium text-texto/90 transition-colors hover:bg-white/[0.06] hover:text-turquesa-claro"
            data-cerrar-menu
          >
            {n.etiqueta}
          </a>
        ))
      }
      <a
        href="/diagnostico"
        class="btn btn-primario mt-3"
        data-evento="diagnostico_click"
        data-ubicacion="menu-movil"
        data-cerrar-menu
      >
        Agenda tu diagnóstico gratis
      </a>
    </nav>
  </div>
</header>
