---
import Icono from './Icono.astro';
import datos from '../data/lab.json';
import { mostrarPendientes, redesActivas, todasLasRedes, vacio } from '../lib/site';

const redes = redesActivas();
const pendientes = todasLasRedes().filter((r) => vacio(r.url));
---

<section
  id="lab"
  class="seccion overflow-hidden"
  aria-labelledby="lab-titulo"
>
  <div class="contenedor">
    <div class="badge-seccion">
      <span class="punto"></span>
      {datos.titulo}
    </div>
    <h2 id="lab-titulo" class="titulo-seccion mt-4 max-w-3xl">{datos.frase}</h2>

    <h3 class="mt-12 font-mono text-xs uppercase tracking-widest text-turquesa">{datos.seriesTitulo}</h3>
    <ul class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        datos.series.map((s) => (
          <li class="tarjeta">
            <span class="inline-block rounded-md border border-turquesa/20 bg-turquesa/[0.06] px-2.5 py-0.5 font-mono text-[0.7rem] uppercase tracking-wider text-turquesa-claro">
              {s.formato}
            </span>
            <h4 class="mt-3 text-lg font-bold text-texto">{s.nombre}</h4>
            <p class="mt-1.5 text-sm leading-relaxed text-suave">{s.descripcion}</p>
          </li>
        ))
      }
    </ul>

    {
      (redes.length > 0 || (mostrarPendientes && pendientes.length > 0)) && (
        <div class="mt-14">
          <p class="font-mono text-xs uppercase tracking-widest text-turquesa mb-4">Síguenos en nuestras plataformas</p>
          <ul class="flex flex-wrap gap-3">
            {redes.map((r) => (
              <li>
                <a
                  href={r.url}
                  class="btn btn-secundario !min-h-11"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icono nombre={r.id} class="h-4 w-4" />
                  {r.nombre}
                  <span class="sr-only"> (se abre en otra pestaña)</span>
                </a>
              </li>
            ))}
            {mostrarPendientes &&
              pendientes.map((r) => (
                <li>
                  <span class="pendiente">[PENDIENTE] {r.nombre}: src/data/site.json</span>
                </li>
              ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
