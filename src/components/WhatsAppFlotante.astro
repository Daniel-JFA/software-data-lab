---
import Icono from './Icono.astro';
import { whatsappUrl } from '../lib/site';

const wa = whatsappUrl();
const enlaceExterno = wa.startsWith('http');
---

<a
  href={wa}
  class="fixed bottom-[max(1.25rem,env(safe-area-inset-bottom))] right-4 z-40 grid h-14 w-14 place-items-center rounded-full bg-ambar text-[#0b1f2a] shadow-[inset_0_1px_0_0_rgba(255,255,255,0.45),0_8px_25px_rgba(242,169,59,0.45)] transition-all duration-200 hover:scale-105 active:scale-95 lg:hidden"
  aria-label="Escríbenos por WhatsApp"
  data-evento="whatsapp_click"
  data-ubicacion="flotante"
  target={enlaceExterno ? '_blank' : undefined}
  rel={enlaceExterno ? 'noopener noreferrer' : undefined}
>
  <Icono nombre="whatsapp" class="h-7 w-7" />
</a>
