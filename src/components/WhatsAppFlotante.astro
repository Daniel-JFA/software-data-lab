---
import Icono from './Icono.astro';
import { whatsappUrl } from '../lib/site';

const wa = whatsappUrl();
const enlaceExterno = wa.startsWith('http');
---

<a
  href={wa}
  class="fixed bottom-[max(1rem,env(safe-area-inset-bottom))] right-4 z-40 grid h-14 w-14 place-items-center rounded-full bg-ambar text-fondo shadow-lg shadow-black/40 transition-transform hover:scale-105 lg:hidden"
  aria-label="Escríbenos por WhatsApp"
  data-evento="whatsapp_click"
  data-ubicacion="flotante"
  target={enlaceExterno ? '_blank' : undefined}
  rel={enlaceExterno ? 'noopener noreferrer' : undefined}
>
  <Icono nombre="whatsapp" class="h-7 w-7" />
</a>
