---
import Icono from './Icono.astro';
import { mostrarPendientes, redesActivas, site, todasLasRedes, vacio } from '../lib/site';

const redes = redesActivas();
const pendientes = todasLasRedes().filter((r) => vacio(r.url));
---

<footer class="border-t border-borde/70 bg-superficie/40 py-10">
  <div class="contenedor flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
    <div>
      <img src="/logo.svg" alt={site.nombre} width="180" height="40" loading="lazy" class="h-9 w-auto" />
      <p class="mt-3 text-sm text-suave">{site.ciudad}</p>
    </div>

    <div class="flex flex-col gap-4 md:items-end">
      {
        (redes.length > 0 || (mostrarPendientes && pendientes.length > 0)) && (
          <ul class="flex flex-wrap gap-3" aria-label="Redes sociales">
            {redes.map((r) => (
              <li>
                <a
                  href={r.url}
                  class="grid h-11 w-11 place-items-center rounded-lg border border-borde text-turquesa transition-colors hover:border-turquesa hover:text-turquesa-claro"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${r.nombre} (se abre en otra pestaña)`}
                >
                  <Icono nombre={r.id} class="h-5 w-5" />
                </a>
              </li>
            ))}
            {mostrarPendientes &&
              pendientes.map((r) => (
                <li>
                  <span class="pendiente">[PENDIENTE] {r.nombre}</span>
                </li>
              ))}
          </ul>
        )
      }
      <p class="text-sm text-suave">
        {site.pie.copyright} ·
        <a
          href={site.sitioPersonal}
          class="text-turquesa underline-offset-4 hover:text-turquesa-claro hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          {site.pie.enlaceTexto}<span class="sr-only"> (se abre en otra pestaña)</span>
        </a>
      </p>
    </div>
  </div>
</footer>
