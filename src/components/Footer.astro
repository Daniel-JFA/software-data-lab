---
import Icono from './Icono.astro';
import { mostrarPendientes, redesActivas, site, todasLasRedes, vacio } from '../lib/site';

const redes = redesActivas();
const pendientes = todasLasRedes().filter((r) => vacio(r.url));
---

<footer class="border-t border-white/[0.08] bg-fondo/80 backdrop-blur-xl py-12">
  <div class="contenedor flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
    <div>
      <img src="/logo.svg" alt={site.nombre} width="737" height="274" loading="lazy" class="h-9 w-auto" />
      <p class="mt-3 text-sm text-suave/80">{site.ciudad}</p>
    </div>

    <div class="flex flex-col gap-5 md:items-end">
      {
        (redes.length > 0 || (mostrarPendientes && pendientes.length > 0)) && (
          <ul class="flex flex-wrap gap-2.5" aria-label="Redes sociales">
            {redes.map((r) => (
              <li>
                <a
                  href={r.url}
                  class="grid h-10 w-10 place-items-center rounded-xl border border-white/[0.08] bg-white/[0.03] text-turquesa-claro transition-all hover:border-turquesa/40 hover:bg-white/[0.08] hover:shadow-[0_0_15px_rgba(127,214,203,0.15)] active:scale-95"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${r.nombre} (se abre en otra pestaña)`}
                >
                  <Icono nombre={r.id} class="h-4 w-4" />
                </a>
              </li>
            ))}
            {mostrarPendientes &&
              pendientes.map((r) => (
                <li>
                  <span class="pendiente">[PENDIENTE] {r.nombre}</span>
                </li>
              ))}
          </ul>
        )
      }
      <p class="text-sm text-suave/80">
        <a href="/politica-datos" class="text-turquesa-claro underline-offset-4 hover:underline transition-colors">Política de datos</a> ·
        {site.pie.copyright} ·
        <a
          href={site.sitioPersonal}
          class="text-turquesa-claro underline-offset-4 hover:underline transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          {site.pie.enlaceTexto}<span class="sr-only"> (se abre en otra pestaña)</span>
        </a>
      </p>
    </div>
  </div>
</footer>
