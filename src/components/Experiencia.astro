---
import datos from '../data/clientes.json';
import { mostrarPendientes } from '../lib/site';

type Cliente = { nombre: string; logo: string; url?: string };
const clientes = datos.clientes as Cliente[];

// Años completos desde el inicio de la trayectoria (se recalcula en cada build).
const [anioInicio, mesInicio] = datos.inicio.split('-').map(Number);
const hoy = new Date();
const anos = hoy.getFullYear() - anioInicio - (hoy.getMonth() + 1 < mesInicio ? 1 : 0);
---

<section
  id="experiencia"
  class="seccion"
  aria-labelledby="experiencia-titulo"
>
  <div class="contenedor">
    <div class="badge-seccion">
      <span class="punto"></span>
      {datos.titulo}
    </div>
    <h2 id="experiencia-titulo" class="titulo-seccion mt-4 max-w-3xl">{datos.frase}</h2>

    <!-- Métricas clave estilo Apple Keynote -->
    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3">
      <div class="tarjeta !p-6 text-center">
        <p class="text-3xl sm:text-4xl font-bold font-mono text-turquesa-claro tracking-tight">+{anos}</p>
        <p class="mt-1.5 text-xs uppercase tracking-wider text-suave font-medium">Años construyendo software</p>
      </div>
      <div class="tarjeta !p-6 text-center">
        <p class="text-3xl sm:text-4xl font-bold font-mono text-turquesa-claro tracking-tight">4</p>
        <p class="mt-1.5 text-xs uppercase tracking-wider text-suave font-medium">Sectores clave</p>
      </div>
      <div class="tarjeta !p-6 text-center col-span-2 sm:col-span-1">
        <p class="text-3xl sm:text-4xl font-bold font-mono text-turquesa-claro tracking-tight">100%</p>
        <p class="mt-1.5 text-xs uppercase tracking-wider text-suave font-medium">Código a la medida</p>
      </div>
    </div>

    <ul class="mt-8 flex flex-wrap gap-2.5" aria-label="Sectores">
      {
        datos.sectores.map((s) => (
          <li class="rounded-full border border-white/[0.1] bg-white/[0.04] px-4 py-1.5 font-mono text-xs text-turquesa-claro backdrop-blur-md transition-colors hover:border-turquesa/40 hover:bg-white/[0.08]">
            {s}
          </li>
        ))
      }
    </ul>

    <div class="mt-14">
      <h3 class="font-mono text-xs uppercase tracking-widest text-turquesa">
        {datos.trayectoriaTitulo} · Más de {anos} años construyendo software
      </h3>
      <ul class="mt-5 grid gap-5 sm:grid-cols-2">
        {
          datos.trayectoria.map((t) => (
            <li class="tarjeta">
              <span class="inline-block rounded-md border border-turquesa/20 bg-turquesa/[0.06] px-2 py-0.5 font-mono text-[0.7rem] uppercase tracking-wider text-turquesa-claro">
                {t.sector}
              </span>
              <h4 class="mt-3 text-lg font-bold text-texto">{t.organizacion}</h4>
              <p class="mt-1 text-sm text-suave">{t.rol}</p>
              {t.periodo && <p class="mt-3 font-mono text-xs text-suave/80">{t.periodo}</p>}
              {t.nota && <p class="mt-2 text-xs italic text-suave/90">{t.nota}</p>}
            </li>
          ))
        }
      </ul>
    </div>

    {
      clientes.length > 0 ? (
        <div class="mt-14">
          <p class="font-mono text-xs uppercase tracking-widest text-turquesa mb-5">Organizaciones que confían en nosotros</p>
          <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" aria-label="Clientes">
            {clientes.map((c) => (
              <li class="grid h-24 place-items-center rounded-2xl border border-white/[0.08] bg-white/[0.04] p-4 backdrop-blur-sm transition-all hover:border-turquesa/30 hover:bg-white/[0.08]">
                {c.url ? (
                  <a href={c.url} target="_blank" rel="noopener noreferrer" aria-label={`Sitio de ${c.nombre}`} class="transition-transform hover:scale-105">
                    <img src={c.logo} alt={`Logo de ${c.nombre}`} height="56" loading="lazy" class="max-h-12 w-auto object-contain brightness-90 hover:brightness-100" />
                  </a>
                ) : (
                  <img src={c.logo} alt={`Logo de ${c.nombre}`} height="56" loading="lazy" class="max-h-12 w-auto object-contain brightness-90" />
                )}
              </li>
            ))}
          </ul>
        </div>
      ) : (
        mostrarPendientes && (
          <p class="pendiente mt-10">
            [PENDIENTE] Logos de clientes autorizados: agrégalos en src/data/clientes.json
          </p>
        )
      )
    }
  </div>
</section>
