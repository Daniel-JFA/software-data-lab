---
import datos from '../data/curso.json';
import { site } from '../lib/site';

const f = datos.formulario;
---

<section id="curso" class="seccion" aria-labelledby="curso-titulo">
  <div class="contenedor grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
    <div>
      <div class="badge-seccion">
        <span class="punto"></span>
        {datos.etiqueta}
      </div>
      <h2 id="curso-titulo" class="titulo-seccion mt-4">
        {datos.titulo} — <span class="text-turquesa-claro">{datos.subtitulo}.</span>
      </h2>
      <p class="mt-4 max-w-xl text-lg text-suave">{datos.descripcion}</p>

      <ol class="mt-10 divide-y divide-white/[0.06] border-y border-white/[0.06]">
        {
          datos.lecciones.map((l, i) => (
            <li class="group flex gap-5 py-4.5 transition-colors hover:bg-white/[0.02] px-2 rounded-xl">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-turquesa/30 bg-turquesa/[0.08] font-mono text-xs font-semibold text-turquesa-claro">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-bold text-texto text-base tracking-tight">{l.titulo}</h3>
                <p class="mt-1 text-sm text-suave leading-relaxed">{l.resumen}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="tarjeta h-fit lg:sticky lg:top-28">
      <h3 class="text-xl font-bold tracking-tight text-texto">{f.titulo}</h3>
      <p class="mt-1.5 text-sm text-suave">{f.descripcion}</p>

      <form
        class="mt-6 space-y-4"
        data-endpoint={site.formularios.cursoEndpoint}
        data-nombre="curso-futbol"
        data-evento-exito="suscripcion_curso"
        data-exito={f.exito}
      >
        <div>
          <label for="curso-nombre" class="mb-1.5 block text-xs font-mono uppercase tracking-wider text-turquesa">Nombre</label>
          <input
            id="curso-nombre"
            name="nombre"
            type="text"
            class="campo"
            autocomplete="name"
            required
            maxlength="120"
          />
        </div>
        <div>
          <label for="curso-correo" class="mb-1.5 block text-xs font-mono uppercase tracking-wider text-turquesa">Correo</label>
          <input
            id="curso-correo"
            name="email"
            type="email"
            class="campo"
            autocomplete="email"
            required
            maxlength="120"
          />
        </div>

        <div style="position: absolute; left: -9999px;" aria-hidden="true">
          <input name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="btn btn-primario w-full">
          {f.boton}
        </button>

        <p class="text-xs leading-relaxed text-suave/80">{f.consentimiento}</p>
        <p data-estado class="min-h-6 text-sm" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>
            class="campo"
            autocomplete="email"
            inputmode="email"
            required
            maxlength="160"
          />
        </div>

        <input type="hidden" name="_subject" value="Lista de espera: curso de análisis de fútbol" />
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>No llenes este campo <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </div>

        <button type="submit" class="btn w-full bg-turquesa text-fondo hover:bg-turquesa-claro disabled:opacity-60">
          {f.boton}
        </button>
        <p data-estado role="status" aria-live="polite" class="min-h-6 text-sm"></p>
        <p class="text-xs text-suave">{f.consentimiento}</p>
      </form>
    </div>
  </div>
</section>
