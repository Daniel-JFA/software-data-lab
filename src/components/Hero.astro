---
import Icono from './Icono.astro';
import { site, whatsappUrl } from '../lib/site';

const { inicio } = site;
const wa = whatsappUrl();
const enlaceExterno = wa.startsWith('http');
---

<section id="inicio" class="relative pt-16 pb-20 sm:pt-24 sm:pb-28" aria-labelledby="inicio-titulo">
  <div class="contenedor relative flex flex-col items-center text-center">
    
    <!-- Etiqueta de contexto y ubicación -->
    <div class="badge-seccion mb-6">
      <span class="punto"></span>
      {inicio.etiqueta}
    </div>

    <!-- Título principal -->
    <h1
      id="inicio-titulo"
      class="max-w-4xl text-4xl font-bold leading-[1.12] tracking-tight sm:text-6xl lg:text-7xl text-balance text-texto"
    >
      {inicio.titulo}
    </h1>

    <!-- Subtítulo -->
    <p class="mt-6 max-w-2xl text-lg sm:text-xl leading-relaxed text-suave text-balance">
      {inicio.subtitulo}
    </p>

    <!-- Botones de acción principales -->
    <div class="mt-8 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto justify-center">
      <a
        href={wa}
        class="btn btn-primario w-full sm:w-auto !px-6 !py-3.5"
        data-evento="whatsapp_click"
        data-ubicacion="hero"
        target={enlaceExterno ? '_blank' : undefined}
        rel={enlaceExterno ? 'noopener noreferrer' : undefined}
      >
        <Icono nombre="whatsapp" class="h-5 w-5" />
        {inicio.botonPrincipal}
      </a>
      <a href="#casos" class="btn btn-secundario w-full sm:w-auto !px-6 !py-3.5">
        Ver casos de estudio
        <Icono nombre="flecha" class="h-4 w-4" />
      </a>
    </div>

    <p class="mt-4 font-mono text-xs tracking-wider text-suave/80">{inicio.nota}</p>

    <!-- Pilares de capacidades reales de ingeniería (reemplaza artefacto ficticio de IA) -->
    <div class="mt-16 sm:mt-24 grid w-full max-w-4xl grid-cols-1 sm:grid-cols-3 gap-4 text-left">
      <div class="tarjeta">
        <span class="font-mono text-xs font-semibold text-turquesa tracking-wider uppercase">01 · Software a la medida</span>
        <h3 class="mt-2 text-base font-bold text-texto">Sistemas que calzan en tu negocio</h3>
        <p class="mt-1.5 text-xs text-suave leading-relaxed">
          Plataformas web, paneles internos y APIs diseñadas exactamente para tu flujo operativo, con código propio y sin pagar licencias innecesarias.
        </p>
      </div>

      <div class="tarjeta">
        <span class="font-mono text-xs font-semibold text-turquesa tracking-wider uppercase">02 · Datos y analítica</span>
        <h3 class="mt-2 text-base font-bold text-texto">Métricas y tableros en vivo</h3>
        <p class="mt-1.5 text-xs text-suave leading-relaxed">
          Extracción, pipelines automatizados y bases de datos estructuradas para que tomes decisiones con números reales y al instante.
        </p>
      </div>

      <div class="tarjeta">
        <span class="font-mono text-xs font-semibold text-turquesa tracking-wider uppercase">03 · IA e IoT aplicado</span>
        <h3 class="mt-2 text-base font-bold text-texto">Tecnología en producción</h3>
        <p class="mt-1.5 text-xs text-suave leading-relaxed">
          Transcripción con Whisper, modelos aplicados a datos de tu sector y telemetría de sensores físicos integrados directamente a la nube.
        </p>
      </div>
    </div>

  </div>
</section>
