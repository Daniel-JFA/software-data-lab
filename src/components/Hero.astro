---
import TopoFondo from './TopoFondo.astro';
import Icono from './Icono.astro';
import { site, whatsappUrl } from '../lib/site';

const { inicio } = site;
const wa = whatsappUrl();
const enlaceExterno = wa.startsWith('http');
---

<section id="inicio" class="relative overflow-hidden" aria-labelledby="inicio-titulo">
  <!-- Efectos de iluminación ambiental estilo Apple -->
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-[420px] w-[700px] -translate-x-1/2 rounded-full bg-verde/10 blur-[140px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute right-0 top-1/4 h-[350px] w-[350px] rounded-full bg-turquesa/[0.08] blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <TopoFondo semilla={3} class="absolute inset-0 h-full w-full text-turquesa opacity-[0.14]" />
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-fondo to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="contenedor relative grid items-center gap-12 pb-20 pt-16 md:pb-32 md:pt-28 lg:grid-cols-[1.3fr_1fr]">
    <div>
      <div class="badge-seccion">
        <span class="punto"></span>
        {inicio.etiqueta}
      </div>

      <h1
        id="inicio-titulo"
        class="mt-6 text-[2.5rem] font-bold leading-[1.05] tracking-[-0.035em] sm:text-5xl lg:text-6xl text-balance text-texto"
      >
        {inicio.titulo}
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-suave">
        {inicio.subtitulo}
      </p>

      <div class="mt-9 flex flex-col gap-3.5 sm:flex-row sm:items-center">
        <a
          href={wa}
          class="btn btn-primario"
          data-evento="whatsapp_click"
          data-ubicacion="hero"
          target={enlaceExterno ? '_blank' : undefined}
          rel={enlaceExterno ? 'noopener noreferrer' : undefined}
        >
          <Icono nombre="whatsapp" class="h-5 w-5" />
          {inicio.botonPrincipal}
        </a>
        <a href="#lab" class="btn btn-secundario">
          {inicio.botonSecundario}
          <Icono nombre="flecha" class="h-4 w-4" />
        </a>
      </div>

      <p class="mt-4 font-mono text-xs tracking-wide text-suave/80">{inicio.nota}</p>
    </div>

    <div class="relative hidden justify-self-center lg:flex items-center justify-center" aria-hidden="true">
      <div class="pointer-events-none absolute h-64 w-64 rounded-full bg-turquesa/15 blur-[90px]"></div>
      <div class="tarjeta relative p-6 backdrop-blur-2xl border-white/[0.1] shadow-[0_20px_50px_rgba(0,0,0,0.5)]">
        <img
          src="/simbolo.svg"
          alt=""
          width="448"
          height="264"
          class="h-auto w-full max-w-[30rem] rounded-lg transition-transform duration-500 ease-out hover:scale-[1.02]"
        />
      </div>
    </div>
  </div>
</section>
