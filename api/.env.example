# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` al repositorio.

# Correo de aviso (SMTP). Ejemplo con Gmail: activa la verificación en dos pasos y crea una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (puerto 587) o ssl (puerto 465)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Cadena larga y aleatoria; sirve para guardar la IP solo como hash. Genera una con: openssl rand -hex 32
IP_SALT=

# Límite de envíos por IP y tipo de formulario: máximo N en la ventana (segundos).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=600
